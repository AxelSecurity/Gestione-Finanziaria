# Percorso DB SQLite (in Docker: file:/data/finance.db)
DATABASE_URL="file:./data/finance.db"
# Genera con: openssl rand -base64 32
AUTH_SECRET="cambia-questo-segreto"
AUTH_TRUST_HOST=true
# Amministratore iniziale: creato SOLO se non esiste. Dopo il primo avvio la password si cambia dal Profilo.
# Se la dimentichi: imposta ADMIN_RESET_PASSWORD=true, riavvia, poi rimuovilo.
# Altri utenti si creano dall'app (menu Utenti).
ADMIN_EMAIL="tu@example.com"
ADMIN_PASSWORD="cambia-password"
# ADMIN_RESET_PASSWORD=true
# Notifiche (opzionali). Bot e SMTP sono globali; chat ID ed email destinatario li imposta ogni utente in Impostazioni.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFY_EMAIL_TO=""
